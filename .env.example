# Server-only. Never prefix with VITE_ — that would ship the key to every visitor's browser.
# Get a key at https://developer.riotgames.com (development keys expire every 24 hours).
# Leave empty to run with demo data.
RIOT_API_KEY=

# Force demo data even when a key is set.
DEMO_MODE=false

# Match your key's limits (development key defaults shown).
RIOT_RATE_PER_SECOND=20
RIOT_RATE_PER_2MIN=100

PORT=3001

# Champion stats: a background collector reads high-elo ranked games so the
# Champions pages have data. It pauses while you browse. Set to false to disable.
CRAWLER=true
# Which server's ladder to collect from, and how often to make a request (ms).
CRAWL_REGION=euw1
CRAWL_PACE_MS=2500

# Password-protect the whole site (user "riot", or SITE_USER). Use it while running on a
# development key: Riot doesn't allow those on a publicly reachable site.
# SITE_PASSWORD=
# SITE_USER=riot

# Code Riot gives you to verify your product URL; served at /riot.txt.
# RIOT_VERIFICATION=

# Your public address, e.g. https://riftwatch.gg — used in the sitemap, canonical links and
# link previews. Leave empty to use the address each request came in on.
# SITE_URL=

# Error alerts. ADMIN_TOKEN (8+ characters) turns on the error list at /admin/errors?token=…
# ALERT_WEBHOOK_URL: a Discord or Slack incoming webhook; new problems and an expired
# Riot key are posted there (each at most once an hour).
# ADMIN_TOKEN=
# ALERT_WEBHOOK_URL=

# Shown on the privacy page as the address for privacy and data requests.
# CONTACT_EMAIL=

# Finished matches kept on disk (about 8 KB each; 20,000 ≈ 160 MB).
# MATCH_STORE_MAX=20000
